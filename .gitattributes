*.cs text eol=crlf
*.cshtml text eol=crlf
*.config text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.sql text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.md text eol=crlf
